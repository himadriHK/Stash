{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Jwt": {
      "SigningKey": "stash-signing-key-change-in-production-min-32-chars",
      "Issuer": "stash-auth",
      "Audience": "stash-app",
      "AccessTokenExpiryMinutes": "15",
      "RefreshTokenExpiryDays": "7"
    }
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "stash"
  }
}
