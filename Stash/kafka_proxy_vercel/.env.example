# Copy to .env (gitignored) for `vercel dev`, and set the same names in the
# Vercel project (Settings -> Environment Variables) for deployments.

# --- Kafka (Aiven / Confluent Cloud) ---
KAFKA_BOOTSTRAP_SERVERS=host:port
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CLIENT_ID=stash-kafka-proxy-vercel
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=20000
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=15000
KAFKA_CONSUMER_HEARTBEAT_MS=3000

# --- Access token validation (must match StashHost.IdentityApi / StashHost.Functions) ---
JWT_SIGNING_KEY=
JWT_ISSUER=stash-auth
JWT_AUDIENCE=stash-app

# --- Policy ---
ALLOWED_PRODUCE_TOPICS=stash.upload.request,stash.dlq
ALLOWED_CONSUME_TOPICS=stash.upload.response
CONSUMER_GROUP_PREFIX=stash-mobile
CORS_ALLOWED_ORIGINS=*
MAX_BODY_BYTES=1048576
POLL_TIMEOUT_MS=8000
