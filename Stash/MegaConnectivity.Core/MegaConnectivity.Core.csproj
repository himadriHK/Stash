<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MegaConnectivity.Core</RootNamespace>
    <AssemblyName>MegaConnectivity.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="0.9.27" />
    <!-- Installs pre-built libnode.dll (Windows/Linux/macOS) so NodeEmbeddingPlatform
         can load the Node.js runtime explicitly. Version synced with the
         node-api-dotnet repo's Directory.Packages.props. -->
    <PackageReference Include="Microsoft.JavaScript.LibNode" Version="20.1800.203" />
  </ItemGroup>

</Project>
