<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Stash.Maui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Stash.Maui.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Title="Sign in">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,48"
            Spacing="14"
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Label
                Text="Stash"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Sign in to your backup account"
                Style="{StaticResource SubHeadline}" />

            <Entry
                AutomationId="LoginEmailEntry"
                Placeholder="Email"
                Keyboard="Email"
                Text="{Binding Email}" />

            <Entry
                AutomationId="LoginPasswordEntry"
                Placeholder="Password"
                IsPassword="True"
                Text="{Binding Password}" />

            <Entry
                AutomationId="LoginDeviceIdEntry"
                Placeholder="Device ID"
                Text="{Binding DeviceId}" />

            <Label
                Text="The device ID identifies this installation. It is generated automatically and can be left unchanged."
                FontSize="12"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Label
                AutomationId="LoginErrorLabel"
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="#B00020" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Button
                AutomationId="LoginButton"
                Text="Sign in"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsNotBusy}" />

            <Button
                AutomationId="GoToRegisterButton"
                Text="Create account"
                Command="{Binding GoToRegisterCommand}"
                IsEnabled="{Binding IsNotBusy}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
