<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Stash.Maui.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Stash.Maui.ViewModels"
    x:DataType="vm:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    Title="Create account">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,48"
            Spacing="14"
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Label
                Text="Create account"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Register this device for Stash backups"
                Style="{StaticResource SubHeadline}" />

            <Entry
                AutomationId="RegisterEmailEntry"
                Placeholder="Email"
                Keyboard="Email"
                Text="{Binding Email}" />

            <Entry
                AutomationId="RegisterPasswordEntry"
                Placeholder="Password (minimum 8 characters)"
                IsPassword="True"
                Text="{Binding Password}" />

            <Entry
                AutomationId="RegisterConfirmPasswordEntry"
                Placeholder="Confirm password"
                IsPassword="True"
                Text="{Binding ConfirmPassword}" />

            <Entry
                AutomationId="RegisterDeviceIdEntry"
                Placeholder="Device ID"
                Text="{Binding DeviceId}" />

            <Label
                AutomationId="RegisterErrorLabel"
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="#B00020" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Button
                AutomationId="RegisterButton"
                Text="Create account"
                Command="{Binding RegisterCommand}"
                IsEnabled="{Binding IsNotBusy}" />

            <Button
                AutomationId="BackToLoginButton"
                Text="Back to sign in"
                Command="{Binding GoBackCommand}"
                IsEnabled="{Binding IsNotBusy}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
