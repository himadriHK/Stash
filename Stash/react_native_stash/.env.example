# Copy this file to .env (git-ignored) and fill in real values.
# Expo inlines EXPO_PUBLIC_* variables into the client bundle at build time.
# These values are not server-side secrets: anyone with the app bundle can read them.
EXPO_PUBLIC_IDENTITY_API_BASE_URL=http://localhost:5102
# Deployed Identity API (same origin as the Kafka proxy):
# EXPO_PUBLIC_IDENTITY_API_BASE_URL=https://<vercel-project>.vercel.app
EXPO_PUBLIC_KAFKA_BOOTSTRAP_SERVERS=kafka.example.com:9093
EXPO_PUBLIC_KAFKA_USERNAME=
EXPO_PUBLIC_KAFKA_PASSWORD=
EXPO_PUBLIC_KAFKA_REST_URL=https://kafka-rest.example.com
EXPO_PUBLIC_KAFKA_REST_USERNAME=
EXPO_PUBLIC_KAFKA_REST_PASSWORD=
EXPO_PUBLIC_KAFKA_CLUSTER_ID=
# When proxy mode is enabled, the Vercel origin above also serves the Kafka proxy,
# so this can use the same origin.
EXPO_PUBLIC_KAFKA_PROXY_BASE_URL=
EXPO_PUBLIC_S3_BUCKET=
EXPO_PUBLIC_S3_REGION=us-east-1
EXPO_PUBLIC_S3_ACCESS_KEY_ID=
EXPO_PUBLIC_S3_SECRET_ACCESS_KEY=
EXPO_PUBLIC_S3_SESSION_TOKEN=
EXPO_PUBLIC_S3_ENDPOINT=
EXPO_PUBLIC_S3_PREFIX=
EXPO_PUBLIC_S3_FORCE_PATH_STYLE=false
EXPO_PUBLIC_S3_PRESIGN_EXPIRY_SECONDS=3600
EXPO_PUBLIC_APPINSIGHTS_CONNECTION_STRING=
EXPO_PUBLIC_UPLOAD_MAX_CONCURRENT_BYTES=268435456
