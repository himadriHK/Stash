{
  "Kafka": {
    "TopicUploadRequest": "stash.upload.request",
    "TopicUploadResponse": "stash.upload.response",
    "TopicDeadLetter": "stash.dlq",
    "Proxy": {
      "BaseUrl": "http://192.168.0.19:3000",
      "PollIntervalMs": 15000,
      "PollTimeoutMs": 8000,
      "MaxRecordsPerPoll": 50,
      "RequestTimeoutSeconds": 45
    }
  },
  "Storage": {
    "Provider": "S3",
    "S3": {
      "Bucket": "stash-uploads-staging",
      "Region": "eu-central-003",
      "AccessKeyId": "foo",
      "SecretAccessKey": "bar",
      "SessionToken": "",
      "Endpoint": "http://192.168.0.19:9090",
      "ForcePathStyle": true,
      "Prefix": "",
      "PresignExpirySeconds": 3600
    }
  },
  "IdentityApiBaseUrl": "http://192.168.0.19:3000",
  "IdentityApiTimeoutSeconds": 30,
  "UploadSettings": {
    "BatchSize": 10,
    "MaxRetries": 3,
    "MaxHostRetries": 3,
    "MaxFileSizeBytes": 524288000,
    "MaxConcurrentBytes": 268435456
  },
  "BackgroundUpload": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "MaxFilesPerRun": 50
  }
}
