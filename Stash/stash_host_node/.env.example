# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
DB_PATH=./data/stash_host.db
LOCAL_ROOT_PATH=D:\StashLibrary
TEMP_DIR=

# Kafka
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=stash-host-node
KAFKA_GROUP_ID=stash-upload-request
KAFKA_REQUEST_TOPIC=stash.upload.request
KAFKA_RESPONSE_TOPIC=stash.upload.response
KAFKA_DLQ_TOPIC=stash.dlq
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_FROM_BEGINNING=false
KAFKA_PAUSE_HIGH_WATERMARK=500
KAFKA_RESUME_LOW_WATERMARK=200
KAFKA_COMMIT_TIMEOUT_MS=10000
KAFKA_DLQ_MIRROR_FAILURES=false

# S3 staging
S3_ENABLED=true
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PREFIX=
S3_REQUEST_TIMEOUT_MS=300000

# JWT (shared HS256 key, minimum 32 characters)
JWT_SIGNING_KEY=
JWT_ISSUER=stash-auth
JWT_AUDIENCE=stash-app
JWT_CLOCK_TOLERANCE_SECONDS=0

# Worker and pipeline defaults (used by later phases)
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_HASH_THREADS=2
IMAGE_CONCURRENCY=2
VIDEO_CONCURRENCY=1
JOB_MAX_ATTEMPTS=4
LEASE_SECONDS=120
HASH_WORKER_TIMEOUT_MS=300000
MEDIA_WORKER_TIMEOUT_MS=600000
HEARTBEAT_SECONDS=30
RECOVERY_INTERVAL_SECONDS=30
DISK_MIN_FREE_BYTES=5368709120
TEMP_RETENTION_HOURS=24
STAGE_TIMEOUT_DOWNLOAD_MS=900000
STAGE_TIMEOUT_VERIFY_MS=300000
STAGE_TIMEOUT_CONVERT_IMAGE_MS=300000
STAGE_TIMEOUT_CONVERT_VIDEO_MS=3600000
STAGE_TIMEOUT_THUMBNAILS_MS=600000
STAGE_TIMEOUT_STORE_MS=600000
STAGE_TIMEOUT_RESPOND_MS=60000
STAGE_TIMEOUT_DELETE_MS=60000
RETRY_BASE_MS=2000
RETRY_MAX_MS=300000
DELETE_TEMP_ON_FAILURE=true

# Media
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_CRF=23
FFMPEG_PRESET=fast
THUMBNAIL_QUALITY=90
IMAGE_JPEG_QUALITY=90
MAX_IMAGE_PIXELS=200000000
HEIC_WORKER_ENABLED=true
RAW_DECODER=libraw

# Dashboard / observability
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USER=
DASHBOARD_PASSWORD=
METRICS_ENABLED=true
COMPONENT_CHECK_INTERVAL_SECONDS=60

